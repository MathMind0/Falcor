sceneBuilder.importScene('../scenes/spaceship/spaceship.obj')
#spaceship = sceneBuilder.getMaterial('matSpaceship')
#spaceship.loadTexture(MaterialTextureSlot.BaseColor, '../scenes/spaceship/spaceship_color.jpg')

# Create materials
floor = StandardMaterial('Floor')
floor.loadTexture(MaterialTextureSlot.BaseColor, 'test_scenes/textures/checker_tile_base_color.png')
floor.loadTexture(MaterialTextureSlot.Specular, 'test_scenes/textures/checker_tile_specular.png')
floor.loadTexture(MaterialTextureSlot.Normal, 'test_scenes/textures/checker_tile_normal.png')
floor.textureTransform = Transform(scaling=float3(0.1, 0.1, 1))
floor.roughness = 0.5

sky = StandardMaterial('Sky')
sky.baseColor = float4(0, 0, 0, 1)
sky.emissiveColor = float3(0.1, 0.1, 0.8)
sky.roughness = 0
#sky.loadTexture(MaterialTextureSlot.Emissive, 'test_scenes/envmaps/20050806-03_hd.hdr')


# Create geometry
quadMesh = TriangleMesh.createQuad()
sphereMesh = TriangleMesh.createSphere()
boxMesh = TriangleMesh.createCube()

sphereMeshID = sceneBuilder.addTriangleMesh(sphereMesh, sky)

# Create mesh instances
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Floor',
        Transform(
            scaling=float3(100, 1, 100),
            translation=float3(0, -2, 0))),
    sceneBuilder.addTriangleMesh(quadMesh, floor)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Sky', Transform(scaling=float3(1000, -1000, 1000), translation=float3(0, 0, 0))),
    sphereMeshID
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Sphere',
        Transform(
            scaling=float3(1, 1, 1),
            translation=float3(5, 1, 0))),
    sceneBuilder.addTriangleMesh(sphereMesh, floor)
)

# Create env map
sceneBuilder.envMap = EnvMap('test_images/cubemap/sorsele3/sorsele3.dds')

# Add lights
light0 = DirectionalLight('Light0')
light0.direction = float3(1, -1, -1)
light0.intensity = float3(5, 5, 5)
#light0.angle = 0.1
sceneBuilder.addLight(light0)

#light1 = PointLight('Light1')
#light1.position = float3(0, 100, 0)
#light1.intensity = float3(5, 5, 5)
#sceneBuilder.addLight(light1)

# Create camera
camera = Camera()
camera.position = float3(0, 5, 10)
camera.target = float3(0, 0, 0)
camera.up = float3(0, 1, 0)
sceneBuilder.addCamera(camera)
sceneBuilder.cameraSpeed = 10


